0:{"buildId":"B61NDWfo9xL3yvlGtD_AZ","rsc":["$","$1","c",{"children":[[["$","section",null,{"className":"bg-pixel-grid relative overflow-hidden bg-navy-800 py-16 lg:py-20","aria-labelledby":"portfolio-hero","children":["$","div",null,{"className":"container-site relative flex flex-col items-center gap-6 text-center","children":[["$","h1",null,{"id":"portfolio-hero","className":"font-heading text-4xl font-bold tracking-tight text-white sm:text-5xl","children":"Our Portfolio"}],["$","p",null,{"className":"max-w-2xl text-base leading-relaxed text-navy-200 sm:text-lg","children":"Real projects, real outcomes. A selection of the websites, platforms, and products we have shipped for organizations we believe in."}]]}]}],["$","section",null,{"aria-labelledby":"portfolio-list","className":"bg-white py-16 lg:py-20","children":["$","div",null,{"className":"container-site flex flex-col gap-10","children":[["$","h2",null,{"id":"portfolio-list","className":"sr-only","children":"Project list"}],["$","$2",null,{"fallback":null,"children":["$","$L3",null,{"projects":[{"id":"cmur2a7uz0007n3s8mq43tkhv","title":"IRRDOSOM","slug":"irrdo","client":"IDIL RELIEF, REHABILITATION AND DEVELOPMENT ORGANIZATION (IRRDO)","category":"Web Development","summary":"A modern, multilingual-ready institutional website for IRRDO — showcasing research programs, publications, and community development initiatives across the Horn of Africa.","content":"## The Challenge\n\nIRRDO needed a professional digital home that could present decades of research and rural development work to international partners, donors, and local communities. Their previous web presence was outdated, difficult to update, and invisible to search engines.\n\n## What We Delivered\n\n- A clean, institutional design system built around IRRDO's identity\n- A structured publication library with filtering by research area and year\n- Program pages that clearly communicate impact to funders and partners\n- A news and announcements system the IRRDO team updates themselves\n- Full technical SEO foundation with structured metadata\n\n## The Result\n\nThe new website gives IRRDO a credible, modern platform to showcase research and attract partnership opportunities. Staff can now publish updates without technical support, and the site's performance scores consistently rank above 95 on major auditing tools.","technologies":["Next.js","TypeScript","Tailwind CSS","Headless CMS"],"externalUrl":"https://www.irrdosom.org","coverImage":"https://yrnmyrthjwvstmzxkzwf.supabase.co/storage/v1/object/public/uploads/2026/10/482a469b-0dda-4f62-bc56-bc60384fcc14.jpg","isFeatured":true,"completedAt":"$D2025-11-15T00:00:00.000Z","order":1,"images":[]},{"id":"cmur2a86k0008n3s8orii344h","title":"Al-Huda Primary & Secondary School","slug":"al-huda-school","client":"Al-Huda Primary & Secondary School","category":"Education","summary":"A complete digital platform for Al-Huda School — admissions information, academic programs, school news, and parent communication for a growing Mogadishu institution.","content":"## The Challenge\n\nAl-Huda Primary & Secondary School relied entirely on word-of-mouth and paper notices. Parents had no central place to find admission requirements, term dates, or school news, and the administration spent hours answering the same phone questions.\n\n## What We Delivered\n\n- A warm, trustworthy design that reflects the school's values\n- A clear admissions journey with requirements, fees, and step-by-step guidance\n- Academic program pages for both primary and secondary levels\n- A news and events section for term announcements and celebrations\n- Mobile-first design — most parents visit from a phone\n\n## The Result\n\nAdmission inquiries now arrive through the website contact form with complete information, dramatically reducing phone administration. The school reports a noticeable rise in applications and parents praise how easy it is to find term dates and school news on their phones.","technologies":["Next.js","TypeScript","Tailwind CSS","Contact Forms"],"externalUrl":"https://alhudapss.com","coverImage":"https://yrnmyrthjwvstmzxkzwf.supabase.co/storage/v1/object/public/uploads/2026/10/f254a758-99cc-4d51-ac48-2d81bf3efa97.jpg","isFeatured":true,"completedAt":"$D2026-03-20T00:00:00.000Z","order":2,"images":[]}]}]}]]}]}]],["$L4"],"$L5"]}],"loading":null,"isPartial":false}
