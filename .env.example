# ============================================================
# QASADAN — Environment variables (EXAMPLE — never commit real values)
# ============================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER put real credentials in committed files.

# --- Database (Supabase Postgres, session pooler, IPv4-friendly) ---
# Vercel/dashboard: Settings → Database → Connection string → Session pooler
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"

# --- Payments: credential encryption key (REQUIRED before saving any payment credentials) ---
# Generates a random 32-byte key, base64-encoded:
#   openssl rand -base64 32
# Losing or changing this key makes stored provider credentials unreadable
# (they must be re-entered). Store a backup copy in a password manager.
PAYMENTS_MASTER_KEY=""

# --- Media storage (Supabase Storage, production) ---
# SUPABASE_URL="https://[ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments: optional WAAFI Pay API endpoint overrides ---
# Defaults are the official endpoints; only set these for corporate proxies
# or automated end-to-end tests (see DEPLOYMENT.md §11).
# WAAFIPAY_SANDBOX_URL="https://sandbox.waafipay.com/asm"
# WAAFIPAY_PRODUCTION_URL="https://api.waafipay.net/asm"
