// QASADAN Web Development Agency — Database Schema
// SQLite (sandbox/dev) — structured for straightforward migration to
// Supabase/PostgreSQL in production (see docs in worklog Phase 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // ADMIN | EDITOR
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([email])
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============ SERVICES ============

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String   @default("Code") // Lucide icon name
  features    String   @default("[]") // JSON-encoded string[]
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============ PORTFOLIO ============

model Project {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  client       String?
  category     String?
  summary      String
  content      String         @default("")
  technologies String         @default("[]") // JSON-encoded string[]
  externalUrl  String?
  coverImage   String?
  isFeatured   Boolean        @default(false)
  isPublished  Boolean        @default(false)
  completedAt  DateTime?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProjectImage[]

  @@index([isPublished, isFeatured])
  @@index([category])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ============ NEWS ============

model NewsCategory {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles NewsArticle[]

  @@index([slug])
}

model NewsArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        @default("")
  coverImage  String?
  categoryId  String?
  category    NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isPublished Boolean       @default(false)
  isArchived  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, publishedAt])
  @@index([categoryId])
}

// ============ TEAM ============

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String?
  imageUrl    String?
  linkedinUrl String?
  twitterUrl  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============ TESTIMONIALS ============

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  clientRole String?
  company    String?
  quote      String
  rating     Int      @default(5)
  imageUrl   String?
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isPublished])
}

// ============ CONTACT INQUIRIES ============

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW | READ | RESPONDED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ============ SITE SETTINGS ============

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
