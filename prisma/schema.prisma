// QASADAN Web Development Agency — Database Schema
// SQLite (sandbox/dev) — structured for straightforward migration to
// Supabase/PostgreSQL in production (see docs in worklog Phase 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // ADMIN | EDITOR
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([email])
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============ SERVICES ============

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String   @default("Code") // Lucide icon name
  features    String   @default("[]") // JSON-encoded string[]
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============ PORTFOLIO ============

model Project {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  client       String?
  category     String?
  summary      String
  content      String         @default("")
  technologies String         @default("[]") // JSON-encoded string[]
  externalUrl  String?
  coverImage   String?
  isFeatured   Boolean        @default(false)
  isPublished  Boolean        @default(false)
  completedAt  DateTime?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProjectImage[]

  @@index([isPublished, isFeatured])
  @@index([category])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ============ NEWS ============

model NewsCategory {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles NewsArticle[]

  @@index([slug])
}

model NewsArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        @default("")
  coverImage  String?
  categoryId  String?
  category    NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isPublished Boolean       @default(false)
  isArchived  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, publishedAt])
  @@index([categoryId])
}

// ============ TEAM ============

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String?
  imageUrl    String?
  linkedinUrl String?
  twitterUrl  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============ TESTIMONIALS ============

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  clientRole String?
  company    String?
  quote      String
  rating     Int      @default(5)
  imageUrl   String?
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isPublished])
}

// ============ CONTACT INQUIRIES ============

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW | READ | RESPONDED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ============ SITE STATS (hero numbers, admin-editable) ============

model SiteStat {
  id        String   @id @default(cuid())
  value     String // e.g. "50+", "24/7", "98%"
  label     String // e.g. "Projects Delivered"
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ============ PRICING PLANS (admin-editable) ============

model PricingPlan {
  id         String   @id @default(cuid())
  name       String // Starter / Professional / Enterprise
  tagline    String? // short description under the name
  price      String // e.g. "$299" or "Custom"
  period     String   @default("per project")
  features   String   @default("[]") // JSON-encoded string[] (included items)
  isFeatured Boolean  @default(false) // "Most Popular" highlight
  ctaLabel   String   @default("Choose Plan")
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, order])
}

// ============ PARTNERS / CLIENTS (admin-editable) ============

model Partner {
  id         String   @id @default(cuid())
  name       String
  category   String? // e.g. "Education", "NGO", "Government"
  logoUrl    String?
  websiteUrl String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, order])
}

// ============ PAYMENTS (Phase 1: provider management) ============
//
// Credentials are stored as a single AES-256-GCM encrypted JSON blob
// (see src/lib/payments/crypto.ts). Secrets NEVER leave the server —
// API responses only expose masked values.

model PaymentProvider {
  id              String    @id @default(cuid())
  code            String    @unique // matches registry code, e.g. "waafipay"
  credentials     String    @default("") // encrypted JSON: { fieldKey: value }
  isSandbox       Boolean   @default(true)
  isActive        Boolean   @default(false) // admin toggle — gates the client checkout
  methods         String    @default("[]") // JSON string[] of enabled payment method codes
  currencies      String    @default("[]") // JSON string[] of enabled currency codes
  lastTestedAt    DateTime?
  lastTestOutcome String? // PASS | PARTIAL | FAIL
  lastTestMsg     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code, isActive])
}

// ============ PAYMENTS (Phase 2: invoices) ============
//
// Invoices are created by the admin and paid by clients through a secure,
// unguessable link: /pay/<token> — token is 192-bit random (base64url).
// Status transitions are strictly controlled in src/lib/payments/invoices.ts
// (PENDING → CANCELLED by admin; the payment flow drives the rest in Phase 4).

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique // human-readable, e.g. INV-2026-0001
  token          String    @unique // secret URL token of the client payment link
  clientName     String
  clientEmail    String? // optional — kept private, never shown on the public pay page
  projectService String // what the invoice is for
  description    String?
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("USD") // validated against supported provider currencies
  dueDate        DateTime?
  status         String    @default("PENDING") // PENDING | PROCESSING | PAID | FAILED | CANCELLED | EXPIRED | REFUNDED
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([status, createdAt])
  @@index([clientName])
}

// ============ PAYMENTS (Phase 3: client checkout — payment attempts) ============
//
// One row per checkout attempt started from the public /pay/<token> page.
// Lifecycle: INITIATING → INITIATED (provider issued the hosted checkout URL)
// → CALLBACK_SUCCESS | CALLBACK_FAILURE (provider callback received — content
// is UNTRUSTED until verified) → SUCCEEDED | FAILED (verification, Phase 4).
// referenceId is the merchant reference sent to the provider (WAAFI Pay
// transactionInfo.referenceId) — unique per attempt, used to match callbacks.

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  providerId    String    // snapshot — no FK: payment history must survive provider removal
  providerCode  String    // e.g. "waafipay"
  providerName  String    // display snapshot, e.g. "WAAFI Pay"
  paymentMethod String    // e.g. MWALLET_ACCOUNT
  amount        Decimal   @db.Decimal(12, 2)
  currency      String
  status        String    @default("INITIATING") // INITIATING | INITIATED | CALLBACK_SUCCESS | CALLBACK_FAILURE | SUCCEEDED | FAILED
  referenceId   String    @unique // QSD-<invoiceNumber>-<hex8>
  orderId       String? // provider order id (WAAFI params.orderId)
  providerTxnId String? // provider transaction id — filled at verification (Phase 4)
  hppUrl        String? // hosted checkout URL (contains no secrets — safe to store)
  callbackData  String? // JSON snapshot of last provider callback (untrusted until verified)
  failureReason String?
  // Phase 4 (verification) — filled when the provider's transaction status
  // is confirmed server-side (HPP_GETTRANINFO / signed webhook trigger):
  payerAccount     String?   // provider-reported payer id (e.g. wallet number)
  verifiedAt       DateTime? // when server-side verification confirmed it
  verificationData String?   // JSON snapshot of the provider's verification response (capped)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([invoiceId, createdAt])
  @@index([status, createdAt])
}

// ============ SITE SETTINGS ============

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
